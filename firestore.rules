rules_version = '2';
// docs/dev/security.md. 아직 정의하지 않은 경로는 모두 차단(기본 거부).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function memberPath(sid) { return /databases/$(database)/documents/spaces/$(sid)/members/$(uid()); }
    function isMember(sid) { return signedIn() && exists(memberPath(sid)) && get(memberPath(sid)).data.status == 'active'; }
    function formerMember(sid) { return signedIn() && exists(memberPath(sid)) && get(memberPath(sid)).data.status in ['left', 'removed']; }
    function isManager(sid) { return isMember(sid) && get(memberPath(sid)).data.access in ['owner', 'manager']; }
    function onlyChanges(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function space(sid) { return get(/databases/$(database)/documents/spaces/$(sid)).data; }
    function seesProgress(sid, ownerUid) {   // 진도 공유 (ACC-22, WS-04)
      return signedIn() && (ownerUid == uid()
        || (isMember(sid) && space(sid).settings.progressSharing == 'everyone'
          && get(/databases/$(database)/documents/spaces/$(sid)/members/$(ownerUid)).data.get('hideProgress', false) != true));
    }
    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // shared/schemas/space.ts 와 같은 값
    function validModules(m) {
      return m.keys().hasOnly(['vocab', 'notes', 'reading', 'reviews', 'missions', 'tests', 'math', 'courses', 'wrongNotes'])
        && m.vocab is bool && m.notes is bool && m.reading is bool && m.reviews is bool && m.missions is bool
        && m.tests is bool && m.math is bool && m.courses is bool && m.wrongNotes is bool;
    }
    function validSettings(s) {
      return s.keys().hasOnly(['joinPolicy', 'whoCanInvite', 'whoCanCreate', 'whoCanHost', 'progressSharing', 'ranking', 'journalVisibility', 'feedback'])
        && s.joinPolicy in ['link', 'approval']
        && s.whoCanInvite in ['everyone', 'managers']
        && s.whoCanCreate in ['everyone', 'managers']
        && s.whoCanHost in ['everyone', 'managers']
        && s.progressSharing in ['everyone', 'self']
        && s.get('journalVisibility', 'space') in ['space', 'private']
        && (!('feedback' in s) || (s.feedback.keys().hasOnly(['scoreEnabled', 'scoreFormat'])
          && s.feedback.scoreEnabled is bool && s.feedback.scoreFormat in ['100', 'grade', 'stars']))
        && s.ranking == resource.data.settings.ranking;
    }

    // WS-53 전체 오늘의 복습: 내 기록만 모든 공간에서
    match /{path=**}/cardStates/{id} {
      allow read: if signedIn() && resource.data.uid == uid();
    }

    // NOTE-39 내 일지 모아 보기: 모든 공간에서 내가 쓴 페이지만
    match /{path=**}/pages/{id} {
      allow read: if signedIn() && resource.data.ownerId == uid();
    }

    match /users/{userId} {
      allow read: if signedIn() && userId == uid();
      // ACC-20 알림 설정: 본인이 notifications 맵만 바꾼다 ({ mention: { inApp: bool }, ... })
      allow update: if signedIn() && userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifications'])
        && request.resource.data.notifications is map
        && request.resource.data.notifications.keys().hasOnly(['mention', 'comment', 'feedbackRequest', 'feedback', 'mission', 'missionReview', 'group']);
      // ACC-24 학습 설정: 본인이 study 맵만 ({ dailyNewCards 0~200, dailyReviewCards 10~1000, flashcardFront })
      allow update: if signedIn() && userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['study'])
        && request.resource.data.study is map
        && request.resource.data.study.keys().hasOnly(['dailyNewCards', 'dailyReviewCards', 'flashcardFront'])
        && request.resource.data.study.dailyNewCards is int && request.resource.data.study.dailyNewCards >= 0 && request.resource.data.study.dailyNewCards <= 200
        && request.resource.data.study.dailyReviewCards is int && request.resource.data.study.dailyReviewCards >= 10 && request.resource.data.study.dailyReviewCards <= 1000
        && request.resource.data.study.flashcardFront in ['front', 'back'];
      // READ-51 연간 독서 목표: 본인이 readingGoal 맵만 ({ year, books 1~365 })
      allow update: if signedIn() && userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readingGoal'])
        && request.resource.data.readingGoal is map
        && request.resource.data.readingGoal.keys().hasOnly(['year', 'books'])
        && request.resource.data.readingGoal.year is int && request.resource.data.readingGoal.year >= 2000 && request.resource.data.readingGoal.year <= 2100
        && request.resource.data.readingGoal.books is int && request.resource.data.readingGoal.books >= 1 && request.resource.data.readingGoal.books <= 365;
      // CMN-30 알림함: 서버가 만들고, 본인은 읽기·읽음 표시·삭제만
      // CMN-62 내 업로드 목록: 서버(registerUpload·deleteUpload)만 쓴다
      match /uploads/{fileId} {
        allow read: if signedIn() && userId == uid();
      }
      match /notifications/{id} {
        allow read, delete: if signedIn() && userId == uid();
        allow update: if signedIn() && userId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    match /spaces/{sid} {
      allow read: if isMember(sid);
      // WS-01·02·04: 소유자·매니저가 일반·기능·운영 방식만 바꾼다. 나머지(인원, 소유자, 삭제 예약)는 서버
      allow update: if resource.data.kind == 'workspace' && isManager(sid)
        && onlyChanges(['name', 'icon', 'color', 'description', 'modules', 'settings', 'subjects', 'updatedAt'])
        && request.resource.data.get('subjects', []) is list && request.resource.data.get('subjects', []).size() <= 30
        && isText(request.resource.data.name, 1, 40)
        && isText(request.resource.data.icon, 1, 16)
        && request.resource.data.color in ['slate', 'red', 'orange', 'amber', 'green', 'teal', 'blue', 'violet', 'pink']
        && isText(request.resource.data.description, 0, 200)
        && validModules(request.resource.data.modules)
        && validSettings(request.resource.data.settings)
        && request.resource.data.updatedAt == request.time;

      match /members/{memberId} {
        allow read: if isMember(sid);
        // WS-31: 그룹 소속은 모든 멤버가 바꾼다. ACC-11·22: 내 표시 이름과 진도 숨기기는 본인이. 다른 항목은 서버
        allow update: if isMember(sid) && space(sid).kind == 'workspace' && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupIds'])
            && request.resource.data.groupIds is list && request.resource.data.groupIds.size() <= 20)
          || (memberId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'hideProgress'])
            && isText(request.resource.data.displayName, 1, 40)
            && request.resource.data.get('hideProgress', false) is bool));
      }

      // WS-30~33 그룹: 모든 멤버가 만들고 고치고 지운다(휴지통처럼 deletedAt, 30일 뒤 서버가 완전 삭제)
      match /groups/{gid} {
        function validGroup(x) {
          return x.keys().hasOnly(['name', 'color', 'joinable', 'createdBy', 'deletedAt', 'deletedBy', 'createdAt', 'updatedAt'])
            && isText(x.name, 1, 40) && isText(x.color, 1, 20) && x.joinable is bool && x.createdBy is string;
        }
        allow read: if isMember(sid);
        allow create: if isMember(sid) && space(sid).kind == 'workspace' && validGroup(request.resource.data)
          && request.resource.data.createdBy == uid() && request.resource.data.deletedAt == null
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if isMember(sid) && validGroup(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt'])
          && (request.resource.data.deletedAt == null || request.resource.data.deletedAt == resource.data.deletedAt
            || (request.resource.data.deletedAt == request.time && request.resource.data.deletedBy == uid()))
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // VOC-01·02·03·05 — docs/dev/security.md 3절 공유 콘텐츠
      match /decks/{deckId} {
        function d() { return resource.data; }
        function nd() { return request.resource.data; }
        function canSee() {
          return d().visibility == 'space'
            || (d().visibility == 'group' && d().groupIds.hasAny(get(memberPath(sid)).data.get('groupIds', [])))
            || d().createdBy == uid();
        }
        function canEdit() {
          return d().createdBy == uid()
            || (d().editPolicy == 'collaborators' && uid() in d().collaboratorIds)
            || d().editPolicy == 'everyone';
        }
        function validDeck(x) {
          return isText(x.title, 1, 80) && isText(x.description, 0, 500)
            && x.langFrom is string && x.langTo is string && (x.folderId == null || x.folderId is string)
            && x.visibility in ['private', 'group', 'space'] && x.groupIds is list && x.groupIds.size() <= 20
            && x.editPolicy in ['author', 'collaborators', 'everyone'] && x.collaboratorIds is list && x.collaboratorIds.size() <= 50
            && x.tags is list && x.tags.size() <= 10 && x.fields is list
            && (sid.matches('p_.*') == false || x.visibility == 'private' || x.visibility == 'space');
        }
        allow read: if isMember(sid) && canSee();
        allow create: if isMember(sid)
          && (space(sid).kind == 'personal' || space(sid).settings.whoCanCreate == 'everyone' || isManager(sid))
          && nd().createdBy == uid() && validDeck(nd())
          && nd().cardCount == 0 && nd().learnerCount == 0
          && nd().createdAt == request.time && nd().updatedAt == request.time;
        allow update: if isMember(sid) && canSee() && canEdit() && validDeck(nd())
          && !nd().diff(d()).affectedKeys().hasAny(['createdBy', 'copiedFrom', 'cardCount', 'learnerCount', 'createdAt'])
          && (d().createdBy == uid() || !nd().diff(d()).affectedKeys().hasAny(['visibility', 'groupIds', 'editPolicy', 'collaboratorIds']))
          && nd().updatedAt == request.time;
        allow delete: if isMember(sid) && (d().createdBy == uid() || isManager(sid));
      }

      // VOC-03: 폴더는 멤버 누구나 만들고, 만든 사람·매니저가 고치고 지운다
      match /decks/{deckId}/cards/{cardId} {
        function deck() { return get(/databases/$(database)/documents/spaces/$(sid)/decks/$(deckId)).data; }
        function seeDeck(dk) {
          return dk.visibility == 'space' || dk.createdBy == uid()
            || (dk.visibility == 'group' && get(memberPath(sid)).data.get('groupIds', []).hasAny(dk.groupIds));
        }
        function editDeck(dk) {
          return dk.createdBy == uid() || (dk.editPolicy == 'collaborators' && uid() in dk.collaboratorIds) || dk.editPolicy == 'everyone';
        }
        function validCard(c) {
          return isText(c.front, 1, 200) && c.back is list && c.back.size() >= 1 && c.back.size() <= 10
            && c.order is number && c.examples is list && c.examples.size() <= 10 && c.tags is list && c.tags.size() <= 10;
        }
        allow read: if isMember(sid) && seeDeck(deck());
        allow create: if isMember(sid) && seeDeck(deck()) && editDeck(deck())
          && validCard(request.resource.data) && request.resource.data.contentRev == 0;
        allow update: if isMember(sid) && seeDeck(deck()) && editDeck(deck())
          && validCard(request.resource.data) && request.resource.data.contentRev == resource.data.contentRev;
        allow delete: if isMember(sid) && seeDeck(deck()) && editDeck(deck());
      }

      match /cardStates/{id} {   // VOC-40
        function validState(d) {
          return d.uid == uid() && id == uid() + '_' + d.cardId && d.deckId is string
            && d.status in ['new', 'learning', 'review', 'mastered'] && d.due is timestamp
            && d.ease is number && d.intervalDays is number;
        }
        allow read: if seesProgress(sid, resource.data.uid);
        allow create: if isMember(sid) && validState(request.resource.data);
        allow update: if isMember(sid) && resource.data.uid == uid() && validState(request.resource.data)
          && request.resource.data.deckId == resource.data.deckId;
        allow delete: if isMember(sid) && resource.data.uid == uid();
      }

      match /studySessions/{id} {
        allow read: if seesProgress(sid, resource.data.uid);
        allow create: if isMember(sid) && request.resource.data.uid == uid()
          && request.resource.data.mode in ['flashcards', 'learn', 'write', 'match', 'review']
          && request.resource.data.cards is int && request.resource.data.correct is int
          && request.resource.data.durationSec is number && request.resource.data.endedAt == request.time;
      }

      match /deckProgress/{id} {
        allow read: if seesProgress(sid, resource.data.uid);
      }

      match /decks/{deckId}/matchTop/{docId} {
        allow read: if isMember(sid);
      }

      match /deckFolders/{folderId} {
        allow read: if isMember(sid);
        allow create: if isMember(sid) && request.resource.data.ownerId == uid()
          && isText(request.resource.data.name, 1, 40) && request.resource.data.order is number;
        allow update: if isMember(sid) && (resource.data.ownerId == uid() || isManager(sid))
          && onlyChanges(['name', 'order']) && isText(request.resource.data.name, 1, 40);
        allow delete: if isMember(sid) && (resource.data.ownerId == uid() || isManager(sid));
      }

      // 2-C1 내 책장 (READ-01~03·05·10·11). 책은 각자 자기 책장에, 묶음(books)은 서버만
      match /shelf/{id} {
        function validShelf(x) {
          return x.uid == uid() && id == uid() + '_' + x.bookKey && isText(x.bookKey, 3, 80)
            && isText(x.title, 1, 200) && x.authors is list && x.authors.size() <= 10
            && isText(x.publisher, 0, 100) && isText(x.cover, 0, 500) && (x.cover == '' || x.cover.matches('https://.*'))
            && x.format in ['paper', 'ebook', 'audio'] && x.status in ['want', 'reading', 'done', 'dropped']
            && (!('rating' in x) || x.rating == null || (x.rating is int && x.rating >= 1 && x.rating <= 5))
            && (!('startedAt' in x) || x.startedAt == null || isText(x.startedAt, 10, 10))
            && (!('finishedAt' in x) || x.finishedAt == null || isText(x.finishedAt, 10, 10))
            && (!('position' in x) || x.position is map);
        }
        allow read: if isMember(sid);
        allow create: if isMember(sid) && validShelf(request.resource.data);
        allow update: if isMember(sid) && resource.data.uid == uid() && validShelf(request.resource.data)
          && request.resource.data.bookKey == resource.data.bookKey;
        allow delete: if isMember(sid) && resource.data.uid == uid();
      }
      match /books/{key} {
        allow read: if isMember(sid);
      }
      // 2-C3 독서 기록 (READ-20·21·23). 기록은 본인만 본다 (피드에는 서버가 올린다)
      match /readingLogs/{id} {
        function validLog(x) {
          return x.uid == uid() && isText(x.bookKey, 3, 80) && isText(x.title, 1, 200) && isText(x.date, 10, 10)
            && x.unit in ['page', 'percent', 'minute'] && x.minutes is int && x.minutes >= 0 && x.minutes <= 1440
            && isText(x.memo, 0, 200);
        }
        allow read: if seesProgress(sid, resource.data.uid);
        allow create: if isMember(sid) && validLog(request.resource.data);
        allow update: if isMember(sid) && resource.data.uid == uid() && validLog(request.resource.data);
        allow delete: if isMember(sid) && resource.data.uid == uid();
      }

      // 2-C4 구절 (READ-30·31). 공개(space)면 멤버 모두, 아니면 본인만
      match /quotes/{id} {
        function validQuote(x) {
          return x.uid == uid() && isText(x.bookKey, 3, 80) && isText(x.title, 1, 200) && isText(x.date, 10, 10)
            && isText(x.text, 1, 1000) && x.unit in ['page', 'percent', 'minute']
            && (x.position == null || (x.position is int && x.position >= 0))
            && x.visibility in ['private', 'space'];
        }
        allow read: if isMember(sid) && (resource.data.uid == uid() || resource.data.visibility == 'space');
        allow create: if isMember(sid) && validQuote(request.resource.data);
        allow update: if isMember(sid) && resource.data.uid == uid() && validQuote(request.resource.data);
        allow delete: if isMember(sid) && resource.data.uid == uid();
      }

      // 3-A1 문제 은행 (TST-01·02·04·07·08). 정답은 questionKeys에 따로 두고 출제자(+공개 설정 시 멤버)만 읽는다
      match /questions/{qid} {
        function validQ(x) {
          return x.keys().hasOnly(['type', 'prompt', 'choices', 'tags', 'subjectId', 'media', 'copiedFrom', 'difficulty', 'defaultPoints', 'createdBy', 'sharing', 'answerVisibility', 'rev', 'deletedAt', 'createdAt', 'updatedAt', 'unit', 'variant'])
            && x.type in ['single', 'multi', 'ox', 'short', 'essay'] && isText(x.prompt, 1, 2000)
            && x.choices is list && x.choices.size() <= 6 && x.tags is list && x.tags.size() <= 10
            && (!('media' in x) || (x.media is list && x.media.size() <= 5))
            && x.difficulty in ['easy', 'normal', 'hard'] && x.defaultPoints is int && x.defaultPoints >= 1 && x.defaultPoints <= 100
            && x.sharing in ['private', 'space'] && x.answerVisibility in ['authors', 'space'] && x.rev is int
            && (x.get('unit', null) == null || (x.unit is map && x.unit.keys().hasOnly(['code', 'custom'])))
            && x.get('variant', false) is bool;
        }
        allow read: if isMember(sid) && (resource.data.createdBy == uid() || resource.data.sharing == 'space');
        allow create: if isMember(sid) && request.resource.data.createdBy == uid() && request.resource.data.deletedAt == null
          && validQ(request.resource.data)
          && (space(sid).kind == 'personal' || space(sid).settings.whoCanCreate == 'everyone' || isManager(sid));
        allow update: if isMember(sid) && resource.data.createdBy == uid() && request.resource.data.createdBy == uid() && validQ(request.resource.data);
      }
      match /questionKeys/{qid} {
        function qAfter() { return getAfter(/databases/$(database)/documents/spaces/$(sid)/questions/$(qid)).data; }
        function validKey(x) {
          return x.keys().hasOnly(['answer', 'ignoreCase', 'ignoreSpaces', 'explanation', 'rubric', 'authorIds', 'answerVisibility', 'tolerance', 'template', 'hints'])
            && (x.get('template', null) == null || (x.template is map
              && x.template.keys().hasOnly(['prompt', 'explanation', 'hints', 'vars', 'calc', 'conds', 'answerExpr', 'wrongExprs'])
              && x.template.vars is list && x.template.vars.size() <= 10 && x.template.calc.size() <= 10 && x.template.conds.size() <= 10))
            && (x.get('hints', []) is list && x.get('hints', []).size() <= 5)
            && (x.get('tolerance', null) == null || (x.tolerance is number && x.tolerance >= 0))
            && x.answer is list && x.answer.size() <= 20 && x.ignoreCase is bool && x.ignoreSpaces is bool
            && isText(x.explanation, 0, 2000) && isText(x.rubric, 0, 2000)
            && x.authorIds == [uid()] && qAfter().createdBy == uid() && x.answerVisibility == qAfter().answerVisibility;
        }
        allow read: if isMember(sid) && (uid() in resource.data.authorIds || resource.data.answerVisibility == 'space');
        allow create: if isMember(sid) && validKey(request.resource.data);
        allow update: if isMember(sid) && uid() in resource.data.authorIds && validKey(request.resource.data);
      }

      // 수학 M2 문제집 (MATH-10·13). 공개(space)면 멤버 모두 읽고, editPolicy가 members면 멤버도 문제 목록만 고친다
      match /problemSets/{setId} {
        function validSet(x) {
          return x.keys().hasOnly(['title', 'description', 'grade', 'unit', 'questionIds', 'visibility', 'editPolicy', 'createdBy', 'deletedAt', 'createdAt', 'updatedAt', 'hintPenalty'])
            && isText(x.title, 1, 80) && isText(x.description, 0, 500)
            && (x.grade == null || isText(x.grade, 1, 10))
            && (x.unit == null || (x.unit is map && x.unit.keys().hasOnly(['code', 'custom'])))
            && x.questionIds is list && x.questionIds.size() <= 100
            && x.visibility in ['private', 'space'] && x.editPolicy in ['owner', 'members']
            && (x.visibility == 'space' || x.editPolicy == 'owner')
            && x.get('hintPenalty', 0) is int && x.get('hintPenalty', 0) >= 0 && x.get('hintPenalty', 0) <= 50
            && (space(sid).kind == 'workspace' || x.visibility == 'private');
        }
        allow read: if isMember(sid) && (resource.data.createdBy == uid() || resource.data.visibility == 'space');
        allow create: if isMember(sid) && request.resource.data.createdBy == uid() && request.resource.data.deletedAt == null
          && validSet(request.resource.data)
          && (space(sid).kind == 'personal' || space(sid).settings.whoCanCreate == 'everyone' || isManager(sid));
        allow update: if isMember(sid) && validSet(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy
          && (resource.data.createdBy == uid()
            || (resource.data.visibility == 'space' && resource.data.editPolicy == 'members' && resource.data.deletedAt == null
              && onlyChanges(['questionIds', 'updatedAt'])));
      }
      // 수학 M4 풀이 기록 (MATH-20·21·24): 본인만 읽고, 숫자(seed)·채점·힌트는 서버(drawProblem·checkProblem·revealHint)만 쓴다
      match /problemAttempts/{attemptId} {
        allow read: if isMember(sid) && attemptId.split('_')[0] == uid();
        allow write: if false;
      }
      // 3-C1 오답 노트 (WRN-01·03): 서버가 쓰고 본인만 읽는다 ({uid}_{refType}_{refId}). 공유(WRN-13)는 3단계 이후
      match /wrongNotes/{noteId} {
        allow read: if isMember(sid) && (resource == null ? noteId.split('_')[0] == uid() : resource.data.uid == uid());
        // WRN-21·22 직접 해결·되돌리기만 본인이 (나머지는 서버)
        allow update: if isMember(sid) && resource.data.uid == uid() && onlyChanges(['resolved', 'resolvedAt', 'consecutiveCorrect'])
          && request.resource.data.resolved is bool && request.resource.data.consecutiveCorrect == 0;
        allow create, delete: if false;
      }
      // MATH-22 풀이 메모: 문제마다 내 메모 하나 ({uid}_{questionId})
      match /problemNotes/{noteId} {
        function validNote(x) {
          return x.keys().hasOnly(['uid', 'questionId', 'text', 'updatedAt'])
            && x.uid == uid() && x.questionId is string && noteId == uid() + '_' + x.questionId && isText(x.text, 0, 5000);
        }
        allow read: if isMember(sid) && noteId.split('_')[0] == uid();
        allow create, update: if isMember(sid) && validNote(request.resource.data);
        allow delete: if isMember(sid) && noteId.split('_')[0] == uid();
      }

      // 3-B1 시험 (TST-10~16). 진행자는 임시저장 상태에서만 고치고, 여는 것(문제 사본·대상자)은 서버 함수(openTest)가 한다
      match /tests/{testId} {
        function canHostTest() {
          return space(sid).kind == 'personal' || isManager(sid) || space(sid).get('settings', {}).get('whoCanHost', 'everyone') == 'everyone';
        }
        function validTest(x) {
          return isText(x.title, 1, 80) && isText(x.description, 0, 2000)
            && x.questionRefs is list && x.questionRefs.size() <= 100
            && x.settings.maxAttempts is int && x.settings.maxAttempts >= 0 && x.settings.maxAttempts <= 10
            && x.settings.scoring in ['best', 'last'] && x.settings.resultRelease in ['instant', 'afterClose', 'scoreOnly', 'hidden']
            && x.settings.shuffleQuestions is bool && x.settings.shuffleChoices is bool && x.settings.practice is bool
            && (x.settings.timeLimitMin == null || (x.settings.timeLimitMin is int && x.settings.timeLimitMin >= 1 && x.settings.timeLimitMin <= 300))
            && x.assignees.all is bool && x.assignees.uids is list && x.assignees.uids.size() <= 200
            && x.assignees.groupIds is list && x.assignees.groupIds.size() <= 20
            && (x.get('mission', null) == null || (x.mission.enabled is bool
                && (x.mission.minScore == null || (x.mission.minScore is int && x.mission.minScore >= 1 && x.mission.minScore <= 10000))))
            && x.hostIds is list && x.hostIds.size() >= 1 && x.hostIds.size() <= 11;
        }
        allow read: if isMember(sid) && (uid() in resource.data.hostIds
          || (resource.data.status in ['open', 'closed'] && uid() in resource.data.get('participantIds', [])));
        allow create: if isMember(sid) && request.resource.data.createdBy == uid() && request.resource.data.hostIds == [uid()]
          && request.resource.data.status == 'draft' && request.resource.data.deletedAt == null
          && !('participantIds' in request.resource.data) && !('missionId' in request.resource.data) && validTest(request.resource.data) && canHostTest();
        allow update: if isMember(sid) && uid() in resource.data.hostIds && request.resource.data.createdBy == resource.data.createdBy
          && ((resource.data.status == 'draft' && request.resource.data.status == 'draft'
                && request.resource.data.hostIds == resource.data.hostIds
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'questionRefs', 'settings', 'assignees', 'mission', 'deletedAt', 'updatedAt'])
                && validTest(request.resource.data))
            || (resource.data.status != 'draft' && request.resource.data.status in ['open', 'closed']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt', 'updatedAt'])));
      }
      match /tests/{testId}/paper/{docId} {
        function tst() { return get(/databases/$(database)/documents/spaces/$(sid)/tests/$(testId)).data; }
        allow read: if isMember(sid) && (uid() in tst().hostIds
          || (tst().status in ['open', 'closed'] && uid() in tst().get('participantIds', [])
              && (tst().settings.openAt == null || request.time.toMillis() >= tst().settings.openAt)));
      }

      // 3-B3 정답 사본: 진행자만 읽는다 (채점 기준 보기)
      match /tests/{testId}/secret/{docId} {
        allow read: if isMember(sid) && uid() in get(/databases/$(database)/documents/spaces/$(sid)/tests/$(testId)).data.hostIds;
      }

      // 3-B2 응시 (TST-21~23). 시작·제출·채점은 서버 함수, 응시자는 마감 전 답만 저장
      match /tests/{testId}/attempts/{attemptId} {
        allow read: if isMember(sid) && (resource.data.uid == uid() || uid() in resource.data.hostIds);
        allow update: if isMember(sid) && resource.data.uid == uid() && resource.data.submittedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers'])
          && request.resource.data.answers is map && request.resource.data.answers.size() <= 100
          && (resource.data.deadlineAt == null || request.time < resource.data.deadlineAt + duration.value(30, 's'));
      }
      // 3-B2 결과 (TST-15·32). 결과 공개 설정에 따라 응시자가 읽는다
      match /tests/{testId}/results/{attemptId} {
        function rt() { return get(/databases/$(database)/documents/spaces/$(sid)/tests/$(testId)).data; }
        function released() {
          return resource.data.isPractice || rt().settings.resultRelease in ['instant', 'scoreOnly']
            || (rt().settings.resultRelease == 'afterClose'
                && (rt().status == 'closed' || (rt().settings.closeAt != null && request.time.toMillis() >= rt().settings.closeAt)));
        }
        allow read: if isMember(sid) && (uid() in resource.data.hostIds || (resource.data.uid == uid() && released()));
      }

      // 2-E1 미션 (MIS-01·02·10~12·14·34). 개인 목표는 만든 사람만 보고, 내 공간에서는 개인 목표만 만든다
      match /missions/{missionId} {
        function canHost() {
          return space(sid).kind == 'workspace'
            && (isManager(sid) || space(sid).get('settings', {}).get('whoCanHost', 'everyone') == 'everyone');
        }
        function validMission(x) {
          return isText(x.title, 1, 80) && isText(x.description, 0, 2000)
            && x.type in ['check', 'submission', 'auto']
            && x.recurrence.kind in ['once', 'daily', 'weekly'] && x.recurrence.weekdays is list && x.recurrence.weekdays.size() <= 7
            && x.startDate is string && (x.endDate == null || (x.endDate is string && x.endDate >= x.startDate))
            && x.allowLate is bool && x.includeSelf is bool && x.joinable is bool && x.isPersonal is bool
            && x.notifyOnComplete in ['feed', 'all', 'none']
            && x.assignees.all is bool && x.assignees.uids is list && x.assignees.uids.size() <= 200
            && x.assignees.get('groupIds', []) is list && x.assignees.get('groupIds', []).size() <= 20
            && x.participantIds is list && x.participantIds.size() <= 500
            && x.hostIds is list && x.hostIds.size() >= 1 && x.hostIds.size() <= 11
            && x.reviewerIds is list && x.reviewerIds.size() <= 20
            && (!x.isPersonal || (x.participantIds == [x.createdBy] && x.hostIds == [x.createdBy] && x.reviewerIds.size() == 0));
        }
        allow read: if isMember(sid) && (!resource.data.isPersonal || resource.data.createdBy == uid());
        allow create: if isMember(sid) && request.resource.data.createdBy == uid() && uid() in request.resource.data.hostIds
          && request.resource.data.closedAt == null && validMission(request.resource.data) && request.resource.data.type != 'auto'
          && (request.resource.data.isPersonal || canHost());
        allow update: if isMember(sid) && uid() in resource.data.hostIds && uid() in request.resource.data.hostIds
          && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.isPersonal == resource.data.isPersonal
          && validMission(request.resource.data)
          && (request.resource.data.type == 'auto') == (resource.data.type == 'auto')
          // MIS-16 시험 연결 미션은 서버가 만들고, 진행자는 종료만 바꾼다
          && (resource.data.type != 'auto' || onlyChanges(['closedAt', 'updatedAt']));
        // MIS-21·24: 진행자가 아닌 멤버는 열린 미션에 자기만 넣거나 뺀다
        allow update: if isMember(sid) && resource.data.joinable && resource.data.closedAt == null
          && onlyChanges(['participantIds'])
          && ((!(uid() in resource.data.participantIds) && request.resource.data.participantIds == resource.data.participantIds.concat([uid()]))
            || (uid() in resource.data.participantIds && request.resource.data.participantIds == resource.data.participantIds.removeAll([uid()])));
        allow delete: if isMember(sid) && resource.data.isPersonal && resource.data.createdBy == uid();
      }

      // MIS-22·23·32: 회차별 제출 `{uid}_{periodKey}`. 본인과 진행자·리뷰어만 본다. 승인·반려는 2-E3
      match /missions/{missionId}/submissions/{subId} {
        function ms() { return get(/databases/$(database)/documents/spaces/$(sid)/missions/$(missionId)).data; }
        function checkers(x) { return x.hostIds.concat(x.reviewerIds).removeAll([uid()]); }
        function validSub(x, mi) {
          return x.uid == uid() && subId == uid() + '_' + x.periodKey && x.periodKey is string
            && isText(x.content, 0, 5000) && (x.pageId == null || x.pageId is string)
            && x.get('attachments', []) is list && x.get('attachments', []).size() <= 10
            && x.late is bool && (!x.late || mi.allowLate)
            && x.reviewerUids is list && x.reviewerUids.toSet() == checkers(mi).toSet()
            && x.status == (mi.type == 'check' || checkers(mi).size() == 0 ? 'done' : 'submitted');
        }
        allow read: if isMember(sid) && (!ms().isPersonal || ms().createdBy == uid())
          && (resource.data.uid == uid() || uid() in ms().hostIds || uid() in ms().reviewerIds);
        // MIS-16 시험 연결 미션의 완료는 서버가 응시 결과로만 기록
        allow create: if isMember(sid) && uid() in ms().participantIds && ms().closedAt == null && ms().type != 'auto'
          && validSub(request.resource.data, ms());
        allow update: if isMember(sid) && resource.data.uid == uid() && ms().closedAt == null && ms().type != 'auto'
          && resource.data.status in ['submitted', 'rejected'] && validSub(request.resource.data, ms())
          && request.resource.data.periodKey == resource.data.periodKey
          && onlyChanges(['content', 'pageId', 'attachments', 'late', 'status', 'reviewerUids', 'submittedAt', 'reason']);
        // MIS-31: 검토자는 검토 대기 제출을 승인·반려(사유 선택)
        allow update: if isMember(sid) && resource.data.status == 'submitted' && uid() in resource.data.reviewerUids
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == uid() && request.resource.data.reviewedAt == request.time
          && isText(request.resource.data.get('reason', ''), 0, 500)
          && onlyChanges(['status', 'reviewedBy', 'reviewedAt', 'reason']);
        allow delete: if isMember(sid) && resource.data.uid == uid() && ms().closedAt == null && ms().type != 'auto'
          && (ms().type == 'check' || resource.data.status == 'submitted');
      }

      // NOTE-01·10 노트 페이지와 블록 (docs/dev/editor.md). 공개 범위 세분화·공동 편집자 지정·잠금은 1-C4
      // NOTE-50·54·60: 공개 범위(나만·지정한 사람·공간 전체), 공동 편집자, 공유 페이지 편집 정책, 편집 잠금(90초)
      function seesPage(p) {
        return p.deletedAt == null && p.get('ownerStatus', 'active') == 'active' && (p.visibility == 'space' || uid() in p.get('sharedWith', []) || uid() in p.editorIds || uid() in p.get('reviewerIds', [])
          || (p.visibility == 'group' && p.groupIds.hasAny(get(memberPath(sid)).data.get('groupIds', []))));
      }
      function editsPage(p) {
        return p.ownerId == uid() || uid() in p.editorIds || (p.root == 'shared' && p.get('editPolicy', 'everyone') == 'everyone');
      }
      function lockFree(p) {
        return p.get('lock', null) == null || p.lock.uid == uid() || p.lock.at < request.time - duration.value(90, 's');
      }
      match /pages/{pageId} {
        function pg() { return resource.data; }
        function np() { return request.resource.data; }
        function validPage(x) {
          return x.type in ['page', 'item', 'journal', 'bookReview'] && (x.type == 'page' || isText(x.get('collectionId', ''), 1, 128))
            && (x.type == 'page' || (x.type == 'journal') == (x.collectionId == 'journal'))
            && (x.type == 'page' || (x.type == 'bookReview') == (x.collectionId == 'bookReview'))
            && (x.type != 'bookReview' || (x.book is map && isText(x.book.bookKey, 3, 80) && isText(x.book.title, 1, 200)))
            && x.get('props', {}) is map && x.get('props', {}).size() <= 20 && isText(x.title, 0, 200) && isText(x.icon, 0, 16)
            && x.root in ['private', 'shared'] && (x.parentId == null || x.parentId is string) && isText(x.order, 1, 256)
            && x.visibility in ['private', 'people', 'group', 'space'] && x.editorIds is list && x.editorIds.size() <= 50
            && x.get('groupIds', []) is list && x.get('groupIds', []).size() <= 20
            && x.get('sharedWith', []) is list && x.get('sharedWith', []).size() <= 50
            && x.get('reviewerIds', []) is list && x.get('reviewerIds', []).size() <= 50
            && x.get('editPolicy', 'everyone') in ['everyone', 'editors']
            && isText(x.excerpt, 0, 200) && x.blockCount is int && x.textLength is int
            && (sid.matches('p_.*') == false || x.visibility == 'private');
        }
        function parentOk(x) {
          return (x.parentId == null && x.ancestorIds.size() == 0)
            || (x.parentId is string && x.ancestorIds.size() <= 9
              && get(/databases/$(database)/documents/spaces/$(sid)/pages/$(x.parentId)).data.root == x.root
              && get(/databases/$(database)/documents/spaces/$(sid)/pages/$(x.parentId)).data.deletedAt == null
              && get(/databases/$(database)/documents/spaces/$(sid)/pages/$(x.parentId)).data.ancestorIds.concat([x.parentId]) == x.ancestorIds);
        }
        // NOTE-46·49: 모음 페이지는 맨 위에만, 모음의 갈래(scope = root)를 따른다. 내 모음에는 만든 사람만 추가
        function collectionOk(x) {
          return x.type == 'page' || (x.parentId == null
            && get(/databases/$(database)/documents/spaces/$(sid)/collections/$(x.collectionId)).data.scope == x.root
            && (x.root == 'shared' || get(/databases/$(database)/documents/spaces/$(sid)/collections/$(x.collectionId)).data.ownerId == uid()));
        }
        // 휴지통의 페이지는 작성자·버린 사람만 본다 (NOTE-22). 옮기기·휴지통은 서버(movePage·trashPage·restorePage)
        allow read: if isMember(sid) && (pg().ownerId == uid() || pg().get('deletedBy', '') == uid()
          || seesPage(pg()))
          // ACC-32: 나가거나 내보내진 사람은 거기 쓴 자기 글을 읽기만 한다
          || (formerMember(sid) && pg().ownerId == uid() && pg().deletedAt == null);
        // NOTE-30·REV-01: 학습일지·독후감은 모든 멤버가 쓰고, 남은 고칠 수 없게(editPolicy: editors) 만든다
        allow create: if isMember(sid)
          && (space(sid).kind == 'personal' || space(sid).settings.whoCanCreate == 'everyone' || isManager(sid) || np().type in ['journal', 'bookReview'])
          && (!(np().type in ['journal', 'bookReview']) || np().get('editPolicy', 'everyone') == 'editors')
          && np().ownerId == uid() && validPage(np()) && np().blockCount == 0 && np().textLength == 0 && np().lock == null
          && np().deletedAt == null && parentOk(np()) && collectionOk(np())
          && np().createdAt == request.time && np().updatedAt == request.time;
        allow update: if isMember(sid) && (pg().ownerId == uid() || seesPage(pg())) && editsPage(pg()) && validPage(np())
          && (!np().diff(pg()).affectedKeys().hasAny(['lock']) || (lockFree(pg())
            && (np().lock == null || (np().lock.uid == uid() && np().lock.at == request.time))))
          && pg().deletedAt == null
          && !np().diff(pg()).affectedKeys().hasAny(['ownerId', 'type', 'collectionId', 'createdAt', 'copiedFrom', 'book', 'missionIds', 'commentCount', 'feedbackCount', 'reactionCounts',
            'parentId', 'ancestorIds', 'deletedAt', 'deletedBy', 'trashRootId'])
          && (pg().ownerId == uid() || !np().diff(pg()).affectedKeys().hasAny(['visibility', 'root', 'groupIds', 'sharedWith', 'editorIds', 'reviewerIds', 'editPolicy']))
          && np().updatedAt == request.time;
        allow delete: if false;
      }

      // NOTE-46~49 내 모음: 내 모음은 만든 사람만, 공유 모음은 모든 멤버가 본다. 설정은 만든 사람(공유 모음은 매니저도)
      match /collections/{cid} {
        function validCollection(x) {
          return (x.kind == 'custom' || (x.kind == 'system' && cid in ['journal', 'bookReview'] && x.get('systemType', '') == cid && (sid.matches('p_.*') || x.scope == 'shared')))
            && isText(x.name, 1, 60) && isText(x.icon, 0, 16) && x.scope in ['private', 'shared']
            && x.schema is list && x.schema.size() <= 20 && x.views is list && x.views.size() <= 20
            && (sid.matches('p_.*') == false || x.scope == 'private');
        }
        allow read: if isMember(sid) && (resource == null || resource.data.scope == 'shared' || resource.data.ownerId == uid());
        allow create: if isMember(sid)
          && (space(sid).kind == 'personal' || space(sid).settings.whoCanCreate == 'everyone' || isManager(sid) || cid in ['journal', 'bookReview'])
          && request.resource.data.ownerId == uid() && validCollection(request.resource.data)
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if isMember(sid) && (resource.data.ownerId == uid() || (resource.data.scope == 'shared' && isManager(sid)))
          && validCollection(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'kind', 'scope', 'createdAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // CMN-20·22 댓글: 대상(지금은 페이지)을 읽을 수 있는 사람이 읽고 쓴다. 수정은 작성자, 삭제는 작성자·매니저. 피드백(kind: feedback)은 서버(leaveFeedback)가 쓰고, 지우기는 댓글과 같다
      match /comments/{id} {
        function target(c) { return get(/databases/$(database)/documents/spaces/$(sid)/pages/$(c.targetId)).data; }
        function readsTarget(c) { return c.targetType == 'page' && (target(c).ownerId == uid() || seesPage(target(c))); }
        function validComment(c) {
          return c.targetType == 'page' && isText(c.targetId, 1, 128) && c.kind == 'comment' && isText(c.body, 1, 2000)
            && c.mentions is list && c.mentions.size() <= 20;
        }
        allow read: if isMember(sid) && readsTarget(resource.data);
        allow create: if isMember(sid) && request.resource.data.uid == uid() && validComment(request.resource.data)
          && readsTarget(request.resource.data) && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'uid', 'kind', 'body', 'mentions', 'createdAt']);
        allow update: if isMember(sid) && resource.data.uid == uid() && validComment(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'mentions', 'editedAt'])
          && request.resource.data.editedAt == request.time;
        allow delete: if isMember(sid) && (resource.data.uid == uid() || isManager(sid));
      }

      // CMN-21 반응: 한 사람당 대상마다 하나 ({targetType}_{targetId}_{uid}). 대상(지금은 페이지)을 읽을 수 있는 사람만
      // CMN-10 활동 피드: 서버만 만든다. 공개 활동은 멤버 모두, 비공개(진도 숨김)는 본인만
      match /activities/{id} {
        allow read: if isMember(sid) && (resource.data.visibility == 'space' || resource.data.uid == uid());
      }
      match /reactions/{id} {
        function rTarget(r) { return get(/databases/$(database)/documents/spaces/$(sid)/pages/$(r.targetId)).data; }
        // CMN-12 피드 반응(`feed`)은 멤버면 누구나. 대상은 활동 ID 또는 같은 날 묶음 키
        function readsR(r) { return r.targetType == 'feed' || (r.targetType == 'page' && (rTarget(r).ownerId == uid() || seesPage(rTarget(r)))); }
        allow read: if isMember(sid) && readsR(resource.data);
        allow create, update: if isMember(sid) && request.resource.data.uid == uid() && readsR(request.resource.data)
          && id == request.resource.data.targetType + '_' + request.resource.data.targetId + '_' + uid()
          && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'uid', 'emoji'])
          && isText(request.resource.data.emoji, 1, 16) && isText(request.resource.data.targetId, 1, 200);
        allow delete: if isMember(sid) && resource.data.uid == uid();
      }

      // CMN-51 공통 태그: 멤버 누구나 읽고 새로 등록한다. 이름·색 변경과 삭제는 매니저만
      match /tags/{tagId} {
        allow read: if isMember(sid);
        allow create: if isMember(sid)
          && request.resource.data.keys().hasOnly(['name', 'color', 'createdBy', 'createdAt'])
          && isText(request.resource.data.name, 1, 30) && isText(request.resource.data.color, 1, 20)
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt == request.time;
        allow update: if isManager(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color'])
          && isText(request.resource.data.name, 1, 30) && isText(request.resource.data.color, 1, 20);
        allow delete: if isManager(sid);
      }

      // NOTE-21 즐겨찾기·최근 본 페이지: 나만 읽고 쓴다
      match /userPrefs/{userId} {
        allow read: if isMember(sid) && userId == uid();
        allow write: if isMember(sid) && userId == uid()
          && request.resource.data.keys().hasOnly(['favoritePageIds', 'recentPageIds'])
          && request.resource.data.favoritePageIds is list && request.resource.data.favoritePageIds.size() <= 50
          && request.resource.data.recentPageIds is list && request.resource.data.recentPageIds.size() <= 20;
      }

      match /pages/{pageId}/blocks/{blockId} {
        function page() { return get(/databases/$(database)/documents/spaces/$(sid)/pages/$(pageId)).data; }
        function seePage(p) { return p.ownerId == uid() || seesPage(p); }
        function editPage(p) { return p.deletedAt == null && editsPage(p) && lockFree(p); }
        function validBlock(b) {
          return isText(b.type, 1, 40) && (b.parentBlockId == null || b.parentBlockId is string) && isText(b.order, 1, 256)
            && b.attrs is map && b.content is list && b.rev is int && b.updatedBy == uid() && b.updatedAt == request.time;
        }
        allow read: if (isMember(sid) && seePage(page())) || (formerMember(sid) && page().ownerId == uid() && page().deletedAt == null);
        allow create, update: if isMember(sid) && seePage(page()) && editPage(page()) && validBlock(request.resource.data);
        allow delete: if isMember(sid) && seePage(page()) && editPage(page());
      }

      // WS-10·11: 생성은 서버(createInvite, 코드 유일성). 만든 사람·매니저가 보고 끄고 켠다
      match /invites/{code} {
        function mine() { return resource.data.createdBy == uid(); }
        allow read: if isMember(sid) && (mine() || isManager(sid));
        allow update: if isMember(sid) && (mine() || isManager(sid))
          && onlyChanges(['disabled', 'updatedAt'])
          && request.resource.data.disabled is bool
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
