rules_version = '2';
// docs/dev/security.md. 아직 정의하지 않은 경로는 모두 차단(기본 거부).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function memberPath(sid) { return /databases/$(database)/documents/spaces/$(sid)/members/$(uid()); }
    function isMember(sid) { return signedIn() && exists(memberPath(sid)) && get(memberPath(sid)).data.status == 'active'; }

    match /users/{userId} {
      allow read: if signedIn() && userId == uid();
    }

    match /spaces/{sid} {
      allow read: if isMember(sid);

      match /members/{memberId} {
        allow read: if isMember(sid);
      }
    }
  }
}
