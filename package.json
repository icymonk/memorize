{
  "name": "memorize",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash tests/e2e/run.sh",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-memorize-rules \"pnpm --dir tests/rules test\"",
    "typecheck": "nuxt typecheck && pnpm --filter functions typecheck",
    "functions:build": "pnpm --filter functions build",
    "emulators": "pnpm functions:build && firebase emulators:start"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@lucide/vue": "^1.52.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-color": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-mathematics": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-unique-id": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "katex": "0.18.10",
