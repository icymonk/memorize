    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase-tools": "^15.32.1",
    "happy-dom": "20.14.5",
    "shadcn-nuxt": "^2.8.2",
    "tailwindcss": "^4.3.3",
